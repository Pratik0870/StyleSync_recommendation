# ---------------------------------------------------------------------------
# BACKEND-ONLY secrets. Copy to `.env` and fill in ONE key.
#
# `.env` is git-ignored and is read by the FastAPI process only. It is never
# bundled into the frontend and never sent to the browser: the React app talks
# to this backend, and the backend talks to the provider.
#
# Set ONE of these. The backend detects which and uses it automatically.
# ---------------------------------------------------------------------------

# Anthropic / Claude (the default provider)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# Optional overrides
# LLM_PROVIDER=anthropic     # anthropic | gemini | none  (none disables the LLM)
# LLM_MODEL=claude-opus-5    # provider-specific model id
