# Where the FastAPI backend runs during development. Only needed if it is not on
# 127.0.0.1:8000. The Vite proxy forwards /recommend, /health, /images,
# /products, /categories and /catalog to this target, so the relative image URLs
# the API returns work without rewriting.
VITE_API_TARGET=http://127.0.0.1:8000

# For a production build served from a different origin than the API, set the
# absolute base the browser should call. Leave empty for same-origin.
# Example: VITE_API_BASE=https://stylesync-api.onrender.com
VITE_API_BASE=
